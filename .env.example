NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://bookaria:bookaria@localhost:5432/bookaria
DATABASE_SSL=false

JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars

CORS_ORIGINS=http://localhost:5173,https://localhost:5174,https://viewer.localhost:5174

SMTP_URL=smtp://localhost:1025
MAIL_FROM="Bookaria <no-reply@bookaria.local>"
GOOGLE_CLIENT_ID=

# Trợ lý tương tác: để AI_MODEL trống để tắt. Khóa chỉ đặt trên backend.
# Ollama cục bộ: AI_BASE_URL=http://localhost:11434/v1, AI_API_KEY để trống.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
# Ứng viên pilot; cố định snapshot sau khi đánh giá trên tập dev.
AI_MODEL=gpt-5.4-mini-2026-03-17
AI_TIMEOUT_MS=40000

# ZeroTTS nội bộ. Chạy services/zerotts/server.py trước khi tạo lời đọc.
ZEROTTS_URL=http://127.0.0.1:8010
ZEROTTS_API_KEY=
ZEROTTS_TIMEOUT_MS=180000

# R2 S3 API (keep credentials on the backend only).
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=bookaria-dev
R2_PUBLIC_URL=

# Optional override; empty uses the bundled FFmpeg / ffprobe binaries.
FFMPEG_PATH=
FFPROBE_PATH=

RUN_WORKER_IN_PROCESS=false

# Hunyuan3D RunPod Serverless (pipeline worker from bookaria-3d-generative)
RUNPOD_MODEL_ENDPOINT_ID=
RUNPOD_MODEL_API_KEY=

# Tài khoản admin do `pnpm db:seed` tạo (chỉ tạo nếu email chưa tồn tại)
SEED_ADMIN_EMAIL=admin@gmail.com
SEED_ADMIN_PASSWORD=

BCRYPT_ROUNDS=12

COOKIE_SECURE=false
COOKIE_SAMESITE=lax
RATE_LIMIT_ENABLED=true

TRUST_PROXY=0

# Thời hạn access token (giây): 900 = 15 phút
ACCESS_TOKEN_TTL_SECONDS=900
# Thời hạn refresh token / phiên đăng nhập (giây): 604800 = 7 ngày
REFRESH_TOKEN_TTL_SECONDS=604800

STUDIO_URL=http://localhost:5173
VIEWER_URL=https://viewer.localhost:5174
PUBLIC_API_URL=https://viewer.localhost:5174

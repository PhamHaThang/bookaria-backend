NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://bookaria:bookaria@localhost:5432/bookaria
DATABASE_SSL=false

JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars

CORS_ORIGINS=http://localhost:5173,http://localhost:5174

SMTP_URL=smtp://localhost:1025
MAIL_FROM="Bookaria <no-reply@bookaria.local>"
GOOGLE_CLIENT_ID=

CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

RUN_WORKER_IN_PROCESS=false

# Tài khoản admin do `pnpm db:seed` tạo (chỉ tạo nếu email chưa tồn tại)
SEED_ADMIN_EMAIL=admin@bookaria.local
SEED_ADMIN_PASSWORD=change-me-admin-password

BCRYPT_ROUNDS=12

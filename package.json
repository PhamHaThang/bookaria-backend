{
    "name": "bookaria-backend",
    "version": "1.0.0",
    "private": true,
    "packageManager": "pnpm@10.34.6",
    "description": "Bookaria backend API và worker",
    "scripts": {
        "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
        "dev:worker": "tsx watch --env-file-if-exists=.env src/worker/main.ts",
        "build": "tsup",
        "start": "node --env-file-if-exists=.env dist/main.js",
        "typecheck": "tsc",
        "test": "vitest run",
        "lint": "biome lint .",
        "format": "biome format --write .",
        "prepare": "git config core.hooksPath .githooks || exit 0",
        "check": "biome check . && pnpm run typecheck && pnpm run test",
        "db:migrate": "node --env-file-if-exists=.env node_modules/node-pg-migrate/bin/node-pg-migrate.js up --migrations-dir migrations --migration-file-language sql",
        "db:rollback": "node --env-file-if-exists=.env node_modules/node-pg-migrate/bin/node-pg-migrate.js down --migrations-dir migrations --migration-file-language sql",
        "db:new": "node --env-file-if-exists=.env node_modules/node-pg-migrate/bin/node-pg-migrate.js create --migrations-dir migrations --migration-file-language sql",
        "db:seed": "tsx --env-file-if-exists=.env src/scripts/seed.ts",
        "docs:openapi": "tsx src/scripts/build-openapi.ts && biome format --write postman/specs",
        "start:api": "node --env-file-if-exists=.env dist/main.js",
        "start:worker": "node --env-file-if-exists=.env dist/worker/main.js",
        "docker:up": "docker compose -f docker/docker-compose.yml up -d",
        "docker:down": "docker compose -f docker/docker-compose.yml down"
    },
    "type": "module",
    "dependencies": {
        "bcryptjs": "^3.0.3",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "express": "^5.2.1",
        "express-rate-limit": "^8.7.1",
        "google-auth-library": "^11.1.0",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.3",
        "nodemailer": "^10.0.15",
        "pg": "^8.23.1",
        "pino": "10.4.0",
        "pino-http": "^11.0.0",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.15",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^26.6.4",
        "@types/nodemailer": "^8.0.2",
        "@types/pg": "^8.23.1",
        "@types/supertest": "^7.2.1",
        "node-pg-migrate": "^9.0.0",
        "pino-pretty": "13.2.0",
        "supertest": "^7.3.1",
        "tsup": "^8.5.1",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2",
        "vitest": "^5.0.3"
    },
    "engines": {
        "node": ">=22.0.0"
    }
}
